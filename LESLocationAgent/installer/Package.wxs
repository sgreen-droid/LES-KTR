<!--
  WiX v5 MSI package for LES Location Agent.

  Installs to:   C:\Program Files\LES Location Agent\
  Data directory C:\ProgramData\LESLocationAgent\ is created at runtime by the app.

  Silent install:   msiexec /i LESLocationAgent.msi /quiet /norestart
  Silent uninstall: msiexec /x LESLocationAgent.msi /quiet /norestart
  Upgrade:          Installing a newer version automatically upgrades the existing one.

  Variable injected by the build command (-d flag):
    PublishDir — absolute path to the dotnet publish output folder
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    Name="LES Location Agent"
    Manufacturer="LES"
    Version="1.1.5.0"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Language="1033"
    InstallerVersion="500"
    Scope="perMachine"
    Compressed="yes">

    <SummaryInformation
      Keywords="LES Location Agent"
      Description="LES Location Agent — Windows location data collector for Action1 RMM"
      Manufacturer="LES" />

    <!-- Allow upgrades; reject downgrades -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of LES Location Agent is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- ============================================================
         Directory layout
         ============================================================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="LES Location Agent" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuDir" Name="LES Location Agent" />
    </StandardDirectory>

    <!-- ============================================================
         File harvesting — WiX v5 uses Include="glob\**" syntax.
         Harvests every file under PublishDir recursively, including
         all Windows App SDK DLLs bundled by the self-contained publish.
         ============================================================ -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!-- Start Menu shortcut (separate component) -->
    <ComponentGroup Id="Shortcuts" Directory="INSTALLFOLDER">
      <Component Id="StartMenuShortcut" Guid="D3E4F5A6-B7C8-9012-DEFA-123456789013">
        <Shortcut Id="StartMenuEntry"
                  Directory="AppStartMenuDir"
                  Name="LES Location Agent"
                  Description="LES Location Agent — Windows location data collector"
                  Target="[INSTALLFOLDER]LESLocationAgent.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppStartMenuDir"
                      Directory="AppStartMenuDir"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\LES\LESLocationAgent"
                       Name="StartMenuInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================
         All-user startup and uninstall protection
         ============================================================ -->
    <ComponentGroup Id="SystemSettings" Directory="INSTALLFOLDER">

      <!-- HKLM Run key: launches the agent at sign-in for EVERY user account.
           Launched with the startup flag so it starts minimised to tray.
           MSI removes this key automatically on uninstall. -->
      <Component Id="AllUserStartup" Guid="F1E2D3C4-B5A6-9078-FEDC-BA9876543210">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="LESLocationAgent"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]LESLocationAgent.exe&quot; --startup"
                       KeyPath="yes" />
      </Component>

      <!-- Sentinel value so the app knows an HKLM startup entry already exists
           and can skip writing a duplicate HKCU entry. -->
      <Component Id="UninstallProtectionFlag" Guid="B2C3D4E5-F6A7-8901-BCDE-F01234567892">
        <RegistryValue Root="HKLM"
                       Key="Software\LES\LESLocationAgent"
                       Name="AllUserStartup"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- Register the Application-log source during elevated MSI setup, so
           standard-user startup failures can be recorded without trying to
           create a machine-wide event source at runtime. -->
      <Component Id="ApplicationEventSource" Guid="A3B4C5D6-E7F8-9012-ABCD-345678901234">
        <util:EventSource
          Name="LESLocationAgent"
          Log="Application"
          EventMessageFile="[INSTALLFOLDER]System.Diagnostics.EventLog.Messages.dll"
          KeyPath="yes" />
      </Component>

      <!-- Pre-grant Windows location consent for the installing user, so the
           OS permission dialog never appears. The app also sets this at each
           startup (per user) as a fallback for other accounts. Permanent="yes"
           so uninstalling the agent doesn't revoke the user's location setting. -->
      <Component Id="LocationConsentAllow" Guid="C4D5E6F7-A8B9-0123-CDEF-456789012345" Permanent="yes">
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\location"
                       Name="Value"
                       Type="string"
                       Value="Allow"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- ============================================================
         Features
         ============================================================ -->
    <Feature Id="ProductFeature" Title="LES Location Agent" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="SystemSettings" />
    </Feature>

    <!-- Uninstall password note:
         VBScript custom actions are deprecated in Windows 11 and not reliable.
         Uninstall protection is enforced at the OS level: this package installs
         perMachine (Scope="perMachine"), so standard users cannot uninstall it —
         only local administrators can. Use Action1 or GPO to control admin rights
         on managed endpoints. Silent uninstall via Action1 remains available to
         IT staff using the provided Action1 scripts. -->

  </Package>
</Wix>
