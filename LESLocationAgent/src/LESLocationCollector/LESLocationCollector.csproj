<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersionWindows)</FileVersion>
    <AssemblyVersion>$(AppVersionWindows)</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LESLocationAgent.Core\LESLocationAgent.Core.csproj" />
    <Compile Include="..\LESLocationAgent\Services\LocationService.cs" Link="LocationService.cs" />
    <Content Include="Remove-CollectorTasks.ps1" CopyToPublishDirectory="Always" />
    <Content Include="Initialize-BackgroundCollector.ps1" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
