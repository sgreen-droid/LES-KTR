<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <!-- Windows 11 21H2 (build 22000) is the supported minimum. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>LESLocationAgent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app: no MSIX, deploys as plain exe via MSI -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The MSI carries the Windows App SDK files; target PCs do not need a
         separate Windows App SDK Runtime installation. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Suppress the XAML-generated Main so Program.cs is the sole entry point -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersionWindows)</FileVersion>
    <AssemblyVersion>$(AppVersionWindows)</AssemblyVersion>
    <!-- ApplicationIcon intentionally omitted; icon is managed via the
         H.NotifyIcon tray resource in App.xaml. Add an .ico file here
         if you want a custom taskbar/window icon. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <!-- System tray icon for WinUI 3 unpackaged apps -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.0" />
    <!-- JSON -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- EventLog / EventLogEntryType — not included by default in .NET 8 -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the platform-agnostic core library -->
    <ProjectReference Include="..\LESLocationAgent.Core\LESLocationAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon assets -->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
