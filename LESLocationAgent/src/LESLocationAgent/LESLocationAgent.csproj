<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LESLocationAgent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app: no MSIX, deploys as plain exe via MSI -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Suppress the XAML-generated Main so Program.cs is the sole entry point -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersionWindows)</FileVersion>
    <AssemblyVersion>$(AppVersionWindows)</AssemblyVersion>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <!-- System tray icon for WinUI 3 unpackaged apps -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.0" />
    <!-- JSON -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the platform-agnostic core library -->
    <ProjectReference Include="..\LESLocationAgent.Core\LESLocationAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon assets -->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
