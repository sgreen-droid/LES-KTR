<Window
    x:Class="LESLocationAgent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LES Location Agent">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Privacy Notice — hardcoded colours; SystemFillColorAttention* variants
             do not exist as brush keys in WinUI 3 generic.xaml and throw at load. -->
        <Border Grid.Row="0"
                Background="#DEEAF7"
                CornerRadius="4"
                Padding="12,8">
            <TextBlock x:Name="PrivacyNoticeText"
                       TextWrapping="Wrap"
                       Foreground="#1A3A5C"
                       FontSize="12"
                       Text="This organization-owned computer uses Windows Location Services for device management and recovery. Location access is controlled by Windows privacy settings." />
        </Border>

        <!-- Location Data Fields -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Location Permission:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PermissionValueText"
                       Text="—" VerticalAlignment="Center" Margin="8,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows Location Status:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LocationStatusText"
                       Text="—" VerticalAlignment="Center" Margin="8,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Latitude:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LatitudeText"
                       Text="—" VerticalAlignment="Center" Margin="8,4" FontFamily="Consolas"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Longitude:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LongitudeText"
                       Text="—" VerticalAlignment="Center" Margin="8,4" FontFamily="Consolas"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Accuracy:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AccuracyText"
                       Text="—" VerticalAlignment="Center" Margin="8,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Altitude:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="AltitudeText"
                       Text="—" VerticalAlignment="Center" Margin="8,4"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Location Source:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LocationSourceText"
                       Text="Windows Geolocation" VerticalAlignment="Center" Margin="8,4"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Position Source:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="PositionSourceText"
                       Text="—" VerticalAlignment="Center" Margin="8,4"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Last Updated:"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="LastUpdatedText"
                       Text="—" VerticalAlignment="Center" Margin="8,4"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button x:Name="EnableLocationButton"
                    Content="Enable Location"
                    Click="EnableLocationButton_Click"
                    MinWidth="130"/>
            <Button x:Name="GetLocationButton"
                    Content="Get Location"
                    Click="GetLocationButton_Click"
                    MinWidth="130"
                    Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="OpenSettingsButton"
                    Content="Open Location Settings"
                    Click="OpenSettingsButton_Click"
                    MinWidth="160"/>
        </StackPanel>

        <!-- Status Bar — hardcoded border colour; SystemFillColorNeutral* Foreground
             variant does not exist as a brush key in WinUI 3 generic.xaml. -->
        <Border Grid.Row="6"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0">
            <TextBlock x:Name="StatusBarText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="{ThemeResource SystemBaseMediumColor}"/>
        </Border>
    </Grid>

</Window>
