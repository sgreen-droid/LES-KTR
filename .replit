modules = ["nodejs-24", "python-base-3.13", "postgresql-16", "dotnet-8.0"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ACTION1_BASE_URL = "https://app.na-2.action1.com/api/3.0"

[nix]
channel = "stable-25_05"
